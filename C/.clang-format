# Presentation contract for clang-format 22.1.8. Formatting is never semantic
# evidence; standards-tests/format owns the representative golden layout.
BasedOnStyle: LLVM
Language: Cpp

ColumnLimit: 80
IndentWidth: 4
ContinuationIndentWidth: 4
TabWidth: 4
UseTab: Never

AlignAfterOpenBracket: true
AlignOperands: Align
AlignEscapedNewlines: Left
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
BinPackArguments: false
BinPackParameters: OnePerLine
BreakAfterOpenBracketFunction: false
BreakAfterReturnType: Automatic
BreakBeforeBinaryOperators: None
BreakBeforeBraces: Linux
BreakBeforeCloseBracketFunction: false
PenaltyReturnTypeOnItsOwnLine: 1000

AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
IndentCaseBlocks: false
IndentCaseLabels: true
IndentGotoLabels: false
InsertBraces: false
RemoveBracesLLVM: false

Cpp11BracedListStyle: Block
DerivePointerAlignment: false
PointerAlignment: Right
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeCaseColon: false
SpaceBeforeParens: ControlStatements

IndentPPDirectives: None
IncludeBlocks: Preserve
SortIncludes:
  Enabled: false

BreakStringLiterals: true
InsertNewlineAtEOF: true
MaxEmptyLinesToKeep: 1
ReflowComments: Never
SeparateDefinitionBlocks: Always

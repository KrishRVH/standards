{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},

	"files": {
		"ignoreUnknown": true
	},

	"javascript": {
		"parser": {
			"jsxEverywhere": false
		}
	},

	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},

	"linter": {
		"domains": {
			"project": "recommended"
		},
		"rules": {
			"correctness": {
				// Bun supports Node built-ins, and TypeScript remains the module-resolution authority.
				"noNodejsModules": "off",
				"noUndeclaredDependencies": "error",
				"noUnresolvedImports": "off"
			}
		}
	}
}

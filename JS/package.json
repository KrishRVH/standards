{
	"name": "project-name",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"audit": "bun audit --audit-level=low",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint --error-on-warnings .",
		"lint:fix": "biome lint --write --error-on-warnings .",
		"standards": "biome check --write --error-on-warnings .",
		"standards:check": "biome ci --error-on-warnings . && bun run typecheck && bun run test && bun run audit",
		"test": "bun test",
		"typecheck": "tsc --pretty -p jsconfig.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/bun": "1.3.14",
		"typescript": "7.0.2"
	}
}

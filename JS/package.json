{
	"name": "project-name",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"audit": "bun audit --audit-level=low",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"knip": "knip",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"standards": "bun run lint:fix && bun run format",
		"standards:check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run audit && bun run knip",
		"test": "bun test",
		"typecheck": "tsc --pretty -p jsconfig.json"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"knip": "6.32.2",
		"oxfmt": "0.64.0",
		"oxlint": "1.80.0",
		"typescript": "7.0.2"
	}
}

//! Lint-wall probe for `tests/lint_wall.rs`. Each marked line must report the
//! marked diagnostic under the gate's Clippy invocation; every other line,
//! including the positive controls, must stay clean.

use std::fmt;
use std::io::{self, Write};
use std::sync::Arc;

// clippy.toml disallows shared-state types, escape-hatch methods, and macros.

/// Reaches into state through a lock.
pub fn locked_state() {
    let _state = std::sync::Mutex::new(0_u8); //~ ERROR clippy::disallowed_types
}

/// Ends the process without unwinding.
pub fn abort() {
    std::process::abort(); //~ ERROR clippy::disallowed_methods
}

std::thread_local! { //~ ERROR clippy::disallowed_macros
    /// Ambient per-thread state.
    pub static AMBIENT: u8 = const { 0 };
}

// Production code carries invariants in types instead of panicking.

/// Parses a count, panicking on bad input.
///
/// # Panics
///
/// Panics when `text` is not a count.
#[must_use]
pub fn parse_count(text: &str) -> u8 {
    text.parse().unwrap() //~ ERROR clippy::unwrap_used
}

// Program output is fallible I/O.

/// Prints through a macro that panics when stdout closes.
pub fn print_report() {
    println!("report"); //~ ERROR clippy::print_stdout
}

/// Prints through a macro that panics when stderr closes.
pub fn print_warning() {
    eprintln!("warning"); //~ ERROR clippy::print_stderr
}

/// Writes output through a locked handle and returns its failure.
///
/// # Errors
///
/// Returns the write or flush error.
pub fn write_report() -> io::Result<()> {
    let mut output = io::stdout().lock();
    writeln!(output, "report")?;
    output.flush()
}

// Shared ownership is a visible, immutable snapshot. The `pub` buffer case
// also needs clippy.toml to turn off the exported-API exemption.

/// Hides shared ownership behind a method call.
#[must_use]
pub fn hidden_share(snapshot: &Arc<str>) -> Arc<str> {
    snapshot.clone() //~ ERROR clippy::clone_on_ref_ptr
}

/// Shares a growable buffer behind a second pointer.
#[must_use]
pub fn buffer_share(snapshot: &Arc<String>) -> usize { //~ ERROR clippy::rc_buffer
    snapshot.len()
}

/// Shares an immutable snapshot visibly.
#[must_use]
pub fn visible_share(snapshot: &Arc<str>) -> Arc<str> {
    Arc::clone(snapshot)
}

// Public types implement `Debug`, and borrows stay visible in signatures.

/// A public type that failures cannot show.
pub struct Opaque; //~ ERROR missing_debug_implementations

/// A label whose formatter hides its borrow.
#[derive(Debug)]
pub struct Label;

impl fmt::Display for Label {
    fn fmt(&self, formatter: &mut fmt::Formatter) -> fmt::Result { //~ ERROR elided_lifetimes_in_paths
        formatter.write_str("label")
    }
}

// Suppression at the configured rust-version: `allow` is rejected, and an
// expectation needs a reason and a lint that still fires.

/// Silences a lint with `allow`.
#[allow(clippy::arithmetic_side_effects, reason = "probe")] //~ ERROR clippy::allow_attributes
#[must_use]
pub fn allowed(value: u8) -> u8 {
    value + 1
}

/// Expects a lint without saying why.
#[expect(clippy::arithmetic_side_effects)] //~ ERROR clippy::allow_attributes_without_reason
#[must_use]
pub fn unexplained(value: u8) -> u8 {
    value + 1
}

/// Expects a lint that fires, with a reason.
#[expect(clippy::arithmetic_side_effects, reason = "probe")]
#[must_use]
pub fn explained(value: u8) -> u8 {
    value + 1
}

/// Expects a lint that no longer fires.
#[expect(clippy::arithmetic_side_effects, reason = "probe")] //~ ERROR unfulfilled_lint_expectations
#[must_use]
pub const fn stale(value: u8) -> u8 {
    value.saturating_add(1)
}

// Test code may unwrap, expect, index, print, and panic, but arithmetic and
// the state wall still apply. Clippy reports arithmetic in test helpers but
// skips `#[test]` bodies (rust-clippy#13845). The unmarked body control stays
// clean until Clippy closes that gap; then drop it and the README sentence.

#[cfg(test)]
mod tests {
    #[test]
    fn tests_may_unwrap_expect_index_and_print() {
        let values = [1_u8, 2];
        let index: usize = "1".parse().unwrap();
        let value: u8 = "2".parse().expect("a number");
        assert_eq!(values[index], value);
        println!("captured {value}");
        eprintln!("captured {value}");
    }

    fn next(value: u8) -> u8 {
        value + 1 //~ ERROR clippy::arithmetic_side_effects
    }

    #[test]
    fn tests_still_check_arithmetic() {
        assert_eq!(next(2), 3);
    }

    #[test]
    fn test_bodies_skip_arithmetic() {
        let value: u8 = "2".parse().unwrap();
        assert_eq!(value + 1, 3);
    }

    #[test]
    fn tests_still_obey_the_state_wall() {
        let _state = std::sync::Mutex::new(0_u8); //~ ERROR clippy::disallowed_types
    }

    #[test]
    #[should_panic(expected = "tests may panic")]
    fn tests_may_panic() {
        panic!("tests may panic");
    }
}

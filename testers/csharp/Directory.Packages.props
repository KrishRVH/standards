<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="CsCheck" Version="4.8.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.176" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.16.1" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fails on analyzable direct compile references reported unused as
         RT0001-RT0003. SDK, transitive, and build-asset references are
         conservatively outside ReferenceTrimmer's scope. -->
    <GlobalPackageReference Include="ReferenceTrimmer" Version="3.5.9" />
  </ItemGroup>
</Project>

{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.24.1/schema/markdownlint-cli2-config-schema.json",
  "globs": ["**/*.{md,mdx}"],
  "gitignore": true,
  "ignores": [
    "**/.build/**",
    "**/.cache/**",
    "**/.git/**",
    "**/.godot/**",
    "**/.gradle/**",
    "**/.kotlin/**",
    "**/.lua_modules/**",
    "**/.next/**",
    "**/.nuxt/**",
    "**/.stack-work/**",
    "**/.svelte-kit/**",
    "**/.turbo/**",
    "**/.vite/**",
    "**/.zig-cache/**",
    "**/_build/**",
    "**/build/**",
    "**/coverage/**",
    "**/deps/**",
    "**/dist/**",
    "**/dist-newstyle/**",
    "**/node_modules/**",
    "**/out/**",
    "**/sbom/**",
    "**/target/**",
    "**/vendor/**",
    "**/zig-cache/**",
    "**/zig-out/**",
    "**/zig-pkg/**"
  ],
  "customRules": ["./scripts/frontmatter.mjs", "./scripts/static-mdx.mjs"],
  "frontMatter": "^---[ \\t]*\\n(?:[^\\n]*\\n)*?---[ \\t]*(?:\\n|$)",
  "noBanner": true,
  "noInlineConfig": true,
  "noProgress": true,
  "config": {
    "default": false,
    // Section paths and heading anchors identify independently retrievable passages.
    "MD001": true,
    "MD003": { "style": "atx" },
    "MD018": true,
    "MD019": true,
    "MD024": true,
    "MD025": { "front_matter_title": "" },
    "MD041": { "front_matter_title": "" },
    // Keep examples, images and references meaningful in the source.
    "MD031": true,
    "MD033": true,
    "MD040": true,
    "MD042": true,
    "MD045": true,
    "MD046": { "style": "fenced" },
    "MD051": true,
    "MD052": true,
    // Keep the destination with the passage that uses the link or image.
    "MD054": { "full": false, "collapsed": false, "shortcut": false },
    "MD056": true,
    "MD059": true,
    "yaml-frontmatter": true
  },
  "overrides": [
    {
      // The MDX parser sees headings, links and images inside JSX, and the title after imports.
      "filter": ["**/*.mdx"],
      "combine": "merge",
      "config": {
        "MD024": false,
        "MD025": false,
        "MD033": false,
        "MD041": false,
        "MD054": false,
        "static-mdx": true
      }
    },
    {
      // GitHub supplies the title above the pull request body.
      "filter": ["**/.github/pull_request_template.md"],
      "combine": "merge",
      "config": { "MD041": false }
    }
  ]
}

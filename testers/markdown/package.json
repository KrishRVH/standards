{
  "name": "project-name-markdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "audit": "bun audit --audit-level=low",
    "format": "prettier \"**/*.{md,mdx}\" --write --cache --list-different",
    "format:check": "prettier \"**/*.{md,mdx}\" --check",
    "lint": "markdownlint-cli2",
    "lint:fix": "markdownlint-cli2 --fix",
    "mdx:check": "bun scripts/check-mdx.mjs",
    "standards": "bun run format && bun run lint:fix",
    "standards:check": "bun run lint && bun run mdx:check && bun run test && bun run format:check",
    "test": "bun test --cwd scripts check-mdx.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@shikijs/rehype": "^4.3.1",
    "js-yaml": "^5.2.2",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "js-yaml": "^5.2.2"
  }
}

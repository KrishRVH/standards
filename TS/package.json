{
  "name": "project-name",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "audit": "bun audit --audit-level=low",
    "effect:check": "effect-language-service diagnostics --project tsconfig.json --severity error,warning",
    "effect:diagnostics:check": "bun run scripts/check-effect-diagnostics.mjs",
    "effect:overview": "effect-language-service overview --project tsconfig.json",
    "format": "prettier . --write --cache --list-different",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "standards": "bun run lint:fix && bun run format",
    "standards:check": "bun run lint && bun run typecheck && bun run type-tests:check && bun run effect:check && bun run effect:diagnostics:check && bun run format:check && bun run test && bun run audit",
    "test": "bun test",
    "type-tests:check": "bun run scripts/check-type-tests.mjs",
    "typecheck": "tsc --pretty -p tsconfig.json"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@effect/platform-bun": "0.91.0",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-regexp": "3.1.1",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}

{
  "name": "project-name",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.1",
  "scripts": {
    "audit": "bun audit --audit-level=low",
    "directives:check": "bun run scripts/check-directives.mjs",
    "effect:check": "effect-language-service diagnostics --project tsconfig.json --severity error,warning",
    "effect:diagnostics:check": "bun run scripts/check-effect-diagnostics.mjs",
    "effect:overview": "effect-language-service overview --project tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "format:secondary": "prettier . --write --cache --list-different",
    "format:secondary:check": "prettier . --check",
    "knip": "knip",
    "lint": "bun run directives:check && oxlint .",
    "lint:fix": "bun run directives:check && oxlint --fix .",
    "lint:secondary": "bun run directives:check && eslint . --max-warnings 0",
    "lint:secondary:fix": "bun run directives:check && eslint . --fix --max-warnings 0",
    "standards": "bun run lint:fix && bun run format",
    "standards:check": "bun run lint && bun run typecheck && bun run type-tests:check && bun run effect:check && bun run effect:diagnostics:check && bun run format:check && bun run test && bun run audit && bun run knip",
    "standards:secondary": "bun run lint:secondary:fix && bun run format:secondary",
    "standards:secondary:check": "bun run lint:secondary && bun run format:secondary:check",
    "test": "bun test",
    "type-tests:check": "bun run scripts/check-type-tests.mjs",
    "typecheck": "tsc --pretty -p tsconfig.json"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@effect/platform-bun": "0.91.2",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "10.0.1",
    "@hughescr/stryker-bun-runner": "1.3.8",
    "@stryker-mutator/core": "10.0.0",
    "@types/bun": "1.4.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-regexp": "3.3.0",
    "fast-check": "4.9.0",
    "globals": "17.12.0",
    "knip": "6.34.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.6",
    "qs": "6.16.0"
  }
}

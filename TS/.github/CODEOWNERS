# The enforcement surface. Replace @OWNER with a real human owner and enable
# "Require review from Code Owners" on the protected branch; that host
# setting is what makes AGENTS.md's "loosening requires human countersign"
# mechanical instead of advisory. eslint.config.* is unanchored on purpose:
# ESLint 10 resolves the nearest config upward from each linted file, so a
# nested config shadows the wall for its subtree. If the mise task fragment
# (20-ts.toml) lives outside /.config/mise/, add its path here.
eslint.config.* @OWNER
/.config/mise/ @OWNER
/.github/ @OWNER
/.prettierignore @OWNER
/AGENTS.md @OWNER
/biome.jsonc @OWNER
/bunfig.toml @OWNER
/effect-diagnostics/tsconfig.json @OWNER
/knip.jsonc @OWNER
/package.json @OWNER
/prettier.config.mjs @OWNER
/scripts/ @OWNER
/stryker.config.mjs @OWNER
/tsconfig.json @OWNER
/type-tests/tsconfig.json @OWNER

{
  "$schema": "./node_modules/@effect/language-service/schema.json",
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "missingDiagnosticNextLine": "error",
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "asyncFunction": "off",
          "cryptoRandomUUID": "off",
          "cryptoRandomUUIDInEffect": "off",
          "effectFnIife": "suggestion",
          "effectGenUsesAdapter": "error",
          "effectInFailure": "error",
          "effectInVoidSuccess": "error",
          "extendsNativeError": "off",
          "genericEffectServices": "error",
          "globalConsole": "off",
          "globalConsoleInEffect": "suggestion",
          "globalDate": "off",
          "globalDateInEffect": "error",
          "globalFetch": "off",
          "globalFetchInEffect": "off",
          "globalRandom": "off",
          "globalRandomInEffect": "error",
          "globalTimers": "off",
          "globalTimersInEffect": "error",
          "instanceOfSchema": "off",
          "layerMergeAllWithDependencies": "error",
          "lazyPromiseInEffectSync": "error",
          "leakingRequirements": "suggestion",
          "missingEffectServiceDependency": "error",
          "multipleEffectProvide": "error",
          "newPromise": "off",
          "nodeBuiltinImport": "off",
          "preferSchemaOverJson": "suggestion",
          "processEnv": "off",
          "processEnvInEffect": "error",
          "returnEffectInGen": "error",
          "runEffectInsideEffect": "error",
          "schemaSyncInEffect": "error",
          "scopeInLayerEffect": "error",
          "strictEffectProvide": "off",
          "unknownInEffectCatch": "error",
          "unsafeEffectTypeAssertion": "error"
        }
      }
    ],
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2024",
    "tsBuildInfoFile": ".tsbuildinfo",
    "types": ["bun-types"],
    "useDefineForClassFields": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["build", "coverage", "dist", "node_modules"]
}

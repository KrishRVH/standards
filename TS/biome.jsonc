{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
  },

  "files": {
    "ignoreUnknown": true,
    // Generated code is intentionally outside Biome formatter, linter, and
    // project-analysis input for this optional profile.
    "includes": ["**", "!**/*.generated.ts"],
  },

  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
    },
  },

  "assist": {
    "enabled": true,
    "actions": {
      "preset": "recommended",
      "source": {
        // Match the primary ESLint sort-imports rule so the two supported
        // profiles never propose opposite repairs.
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "lexicographic",
          },
        },
      },
    },
  },

  "linter": {
    "enabled": true,
    "domains": {
      "project": "recommended",
      "test": "recommended",
      "types": "recommended",
    },
    "rules": {
      "preset": "recommended",
      "nursery": {
        "recommended": false,
      },
      "style": {
        // Targeted beyond recommended: modules should expose named contracts,
        // and constructor syntax should not hide runtime initialization.
        "noDefaultExport": "error",
        "noParameterProperties": "error",
      },
    },
  },

  "overrides": [
    // Keep this alternative config compatible with Option A's Prettier gate.
    {
      "includes": ["biome.jsonc"],
      "json": {
        "formatter": {
          "trailingCommas": "all",
        },
      },
    },
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "off",
          },
        },
      },
    },
    {
      "includes": ["**/*.config.{js,mjs,ts}"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
          },
        },
      },
    },
  ],
}
